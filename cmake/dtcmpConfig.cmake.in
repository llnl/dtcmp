@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

find_dependency(MPI COMPONENTS C)

# lwgrp is a private dependency, consumers only need it to link a static dtcmp
if(NOT @BUILD_SHARED_LIBS@)
    set(_dtcmp_module_path ${CMAKE_MODULE_PATH})
    list(PREPEND CMAKE_MODULE_PATH ${CMAKE_CURRENT_LIST_DIR})
    find_dependency(LWGRP)
    set(CMAKE_MODULE_PATH ${_dtcmp_module_path})
    unset(_dtcmp_module_path)
endif()

include(${CMAKE_CURRENT_LIST_DIR}/dtcmpTargets.cmake)

check_required_components(dtcmp)
